FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DB_PATH=/data/tracker.db

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Non-root user. UID/GID 1000 by default; override at build time if your NAS
# folder is owned by another user (docker compose build --build-arg APP_UID=...).
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g ${APP_GID} app && useradd -u ${APP_UID} -g app -m -s /usr/sbin/nologin app \
    && mkdir -p /data && chown app:app /data

COPY --chown=app:app . .

USER app
EXPOSE 8000
VOLUME ["/data"]

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
