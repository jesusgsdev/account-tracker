# Copy to .env (cp .env.example .env) and fill in. .env is gitignored.

# Login credentials. Generate the hash with:  python backend/hash_password.py
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Set to 1 ONLY when the app is served over HTTPS (otherwise the browser drops the login cookie)
# COOKIE_SECURE=1

# Comma-separated allowed browser origins (only needed if the UI is served from another origin)
CORS_ORIGINS=

# Container user ids (match the owner of ./data on the NAS if needed; read by compose)
APP_UID=1000
APP_GID=1000

# Optional image tag override for docker-compose.ghcr.yml (defaults to "latest")
# APP_VERSION=v1.0.0

# Daily auto-snapshot of share-holding accounts at live prices (writes "[auto-snapshot]" audit rows)
SNAPSHOT_ENABLED=1
SNAPSHOT_HOUR_UTC=21

# Automatic dated JSON backups (backup-YYYYMMDD-HHMMSS.json)
BACKUP_ENABLED=1
BACKUP_HOUR_UTC=3
# Default: <dir of DB_PATH>/backups  (=> ./data/backups in Docker, already persisted)
BACKUP_DIR=
BACKUP_KEEP=14
